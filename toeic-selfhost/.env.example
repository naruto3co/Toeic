# URL người dùng thực sự mở. Không có dấu / ở cuối.
# Dùng HTTPS khi đưa lên Internet. Ví dụ:
PUBLIC_ORIGIN=https://toeic.example.com
# Nếu thử trên chính server: PUBLIC_ORIGIN=http://localhost:8081
APP_PORT=8081

# Cho phép người dùng tự tạo tài khoản học viên. Đặt false để chỉ admin cấp tài khoản.
ALLOW_REGISTRATION=true
